# --- Core ---------------------------------------------------------------
DATABASE_URL=postgres://postflow@localhost:54329/postflow
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kathmandu
# Generate with: npm run hash-password -- 'your password'
APP_PASSWORD_HASH=
APP_USER_EMAIL=me@example.com
# 32+ random chars: openssl rand -base64 48
SESSION_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Fireworks AI (server-side only) -------------------------------------
FIREWORKS_API_KEY=
# Pick a current model ID from https://fireworks.ai/models  (e.g. accounts/fireworks/models/...)
FIREWORKS_MODEL=
# Optional stronger model for "Research deeper" and drafting. Defaults to FIREWORKS_MODEL.
FIREWORKS_RESEARCH_MODEL=
# Reasoning models (e.g. DeepSeek V4.x) think before answering, and that uses output tokens.
# none | low | medium | high, or "off" to not send the parameter. Defaults: routine=none, research=low.
FIREWORKS_REASONING_EFFORT_ROUTINE=
FIREWORKS_REASONING_EFFORT_RESEARCH=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Optional: current prices (USD per 1M tokens) from your Fireworks pricing page, used for spend estimates.
FIREWORKS_PRICE_INPUT_PER_M=
FIREWORKS_PRICE_OUTPUT_PER_M=

# --- GitHub (optional, raises API rate limit) ----------------------------
GITHUB_TOKEN=

# --- LinkedIn (optional) -------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Callback must match the redirect URL registered in the LinkedIn developer app:
#   ${APP_URL}/api/oauth/linkedin/callback

# --- X (optional) --------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
# Callback must match the X app settings:  ${APP_URL}/api/oauth/x/callback

# --- LinkedIn API version (optional) -------------------------------------
# Header value YYYYMM. Defaults to 202511; bump it if LinkedIn sunsets the default.
LINKEDIN_VERSION=

# --- Paid image generation (optional, off by default) --------------------
# Cards, carousels and OG-preview images are rendered locally for free and need no key.
# A key here only enables *decorative* AI art on demand, from the draft's Images panel.
# Black Forest Labs (flux):  https://api.bfl.ai
BFL_API_KEY=
# OpenAI (gpt-image-1)
OPENAI_API_KEY=
