# --- Core ---------------------------------------------------------------
# Neon / Supabase connection string in production (use the pooled one)
DATABASE_URL=postgres://postflow@localhost:54329/postflow
APP_URL=http://localhost:3000
# npm run hash-password -- 'your password (10+ chars)'
APP_PASSWORD_HASH=
# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32   (encrypts LinkedIn/X tokens at rest)
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 24      (your scheduler sends this as a Bearer token to /api/cron/tick)
CRON_SECRET=

# --- Fireworks AI -----------------------------------------------------------
FIREWORKS_API_KEY=
# Pick a current model id from https://fireworks.ai/models
FIREWORKS_MODEL=
# Optional: a stronger model for the reviewer (recommended). Defaults to FIREWORKS_MODEL.
FIREWORKS_REVIEW_MODEL=
# none | low | medium | high, or "off" to not send the parameter
FIREWORKS_REASONING_EFFORT=
# Hard cap on model calls per rolling 24h
MAX_LLM_CALLS_PER_DAY=150

# --- LinkedIn (https://www.linkedin.com/developers/apps) ----------------------
# Products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# Redirect URL: ${APP_URL}/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- X (https://developer.x.com) ---------------------------------------------
# OAuth 2.0, Read and write. Callback: ${APP_URL}/api/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Telegram (free): alerts with a Remove button, and notes by message ---------
# 1) Talk to @BotFather -> /newbot -> copy the token
# 2) Set a random TELEGRAM_WEBHOOK_SECRET (openssl rand -hex 24), deploy, press "Register webhook" in Settings
# 3) Send /start to your bot; it replies with your chat id -> set TELEGRAM_CHAT_ID, redeploy
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
