# --- Core ---------------------------------------------------------------
# Neon / Supabase connection string in production (use the pooled one)
DATABASE_URL=postgres://postflow@localhost:54329/postflow
# Your public site address, e.g. https://postflow.netlify.app or https://postflow.app
APP_URL=http://localhost:3000
# openssl rand -base64 48   (signs sign-in sessions)
SESSION_SECRET=
# openssl rand -base64 32   (encrypts LinkedIn/X tokens at rest)
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 24      (protects the scheduler endpoints)
CRON_SECRET=

# --- Your business ------------------------------------------------------
# Admin emails, comma separated: full access, never billed, can open /admin.
# The first time one of them signs in, it takes over the data from the single-user version.
OWNER_EMAILS=you@example.com
# "true" lets anyone create an account. Anything else: landing page shows the waitlist.
SIGNUPS_OPEN=false
# "true" makes PostFlow free for every confirmed account (no trial, no checkout). Remove it to start charging.
FREE_BETA=false
COMPANY_NAME=PostFlow
# Shown on the legal pages and used as the reply-to address of emails
CONTACT_EMAIL=

# --- Sign in with Google (optional) -------------------------------------
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---------------------------------------------------------------
# Without either option, emails are only written to the server log (fine for local development).
# Option 1, Gmail (no domain needed, about 500 emails a day). Turn on 2-Step Verification,
# then create an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=PostFlow
# Option 2, Resend (resend.com). Used when Gmail is not set. Needs a domain you own.
RESEND_API_KEY=
# A sender on a domain you verified in Resend
EMAIL_FROM=PostFlow <hello@yourdomain.com>

# --- Payments: Stripe (stripe.com) --------------------------------------
# Use test keys (sk_test_...) until you are ready to charge real cards.
STRIPE_SECRET_KEY=
# From Developers > Webhooks > your endpoint ${APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Fireworks AI -----------------------------------------------------------
FIREWORKS_API_KEY=
# Pick a current model id from https://fireworks.ai/models
FIREWORKS_MODEL=
# Optional: a stronger model for the reviewer (recommended). Defaults to FIREWORKS_MODEL.
FIREWORKS_REVIEW_MODEL=
# none | low | medium | high, or "off" to not send the parameter
FIREWORKS_REASONING_EFFORT=
# Model-call cap per rolling 24h for owner accounts (customers get their plan's cap)
MAX_LLM_CALLS_PER_DAY=150
# Hard stop across all users per rolling 24h
MAX_LLM_CALLS_PER_DAY_TOTAL=5000

# --- LinkedIn (https://www.linkedin.com/developers/apps) ----------------------
# Products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# Redirect URL: ${APP_URL}/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- X (https://developer.x.com) ---------------------------------------------
# OAuth 2.0, Read and write. Callback: ${APP_URL}/api/oauth/x/callback
# X bills YOUR developer account per post for every customer.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Telegram (one bot for all customers) -------------------------------------
# 1) Talk to @BotFather -> /newbot -> copy the token and the bot's username
# 2) Set a random TELEGRAM_WEBHOOK_SECRET (openssl rand -hex 24), deploy, then press
#    "Register Telegram webhook" on /admin. Customers link their chat from Settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
